# --- Recall.ai (dashboard → Developers → API Keys & Secrets) ---
RECALL_API_KEY=your_recall_api_key
RECALL_REGION=us-west-2
RECALL_VERIFICATION_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Must be a STABLE public HTTPS URL (static ngrok domain in dev)
PUBLIC_URL=https://your-static-domain.ngrok-free.app
BOT_NAME=DailyScribe
TRANSCRIPT_LANGUAGE=en

# --- Claude ---
GEMINI_API_KEY=
ACTION_MODEL=gemini-3.5-flash-lite
FOCUS_MODEL=gemini-3.5-flash-lite

# --- MCP server tokens referenced from mcp_servers.json ---
JIRA_MCP_TOKEN=
SLACK_MCP_TOKEN=
CALENDAR_MCP_TOKEN=
# Public HTTPS URL of the Calendar MCP server: gcal_mcp (profile gcal) or the stub, behind a proxy/tunnel
CALENDAR_MCP_URL=
# Google Calendar MCP server (gcal_mcp) credentials. Its bearer token is CALENDAR_MCP_TOKEN above
GOOGLE_REFRESH_TOKEN=
GCAL_CALENDAR_ID=primary

# --- OpenProject MCP server (openproject_mcp, profile openproject) ---
# Your OpenProject base URL and an API key of a user with access to the SIRAP project
OPENPROJECT_URL=https://your-openproject.example.com
OPENPROJECT_API_KEY=
# Bearer token the app sends to openproject_mcp (also used by the server itself)
OPENPROJECT_MCP_TOKEN=
# Public HTTPS URL of openproject_mcp, e.g. https://your-domain/openproject-mcp/mcp
OPENPROJECT_MCP_URL=
# Daily mode: project whose blocked HU are read at the start, and the work package that receives the metrics
OPENPROJECT_PROJECT_ID=sirap
OPENPROJECT_DAILY_WP_ID=

# --- Google Meet notes (Gemini "Notas de Gemini" docs in Drive) ---
# Refresh token with the drive.readonly scope (re-consent needed; separate from the calendar token)
GOOGLE_REFRESH_TOKEN_NOTES=
# How long, after bot.done, to wait for Gemini to write the notes doc, and how often to check
MEET_NOTES_WAIT_S=600
MEET_NOTES_POLL_S=60

# --- Google Calendar connection (optional: open GET /calendar/google/connect once) ---
# OAuth "Web application" client from Google Cloud. Authorized redirect URI:
# ${PUBLIC_URL}/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Recall calendar ids only, never Google tokens. Docker sets /app/data/calendars.json itself
CALENDAR_DB=data/calendars.json

# --- Notices (optional) ---
# Slack or Google Chat incoming webhook: announces each meeting before the bot is admitted
NOTIFY_WEBHOOK_URL=

# --- Behaviour ---
AUTO_EXECUTE=false
DRY_RUN=false
DETECT_INTERVAL_S=15
FOCUS_INTERVAL_S=45
WINDOW_S=150
DRIFT_STRIKES=2
WARN_COOLDOWN_S=180
MIN_WINDOW_WORDS=40
PROJECT_INTERVAL_S=60
DAILY_TOTAL_S=900
DAILY_MIN_TURN_S=30
METRICS_DIR=metrics
