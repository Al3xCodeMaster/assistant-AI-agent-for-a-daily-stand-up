# --- Recall.ai (dashboard → Developers → API Keys & Secrets) ---
RECALL_API_KEY=your_recall_api_key
RECALL_REGION=us-west-2
RECALL_VERIFICATION_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Must be a STABLE public HTTPS URL (static ngrok domain in dev)
PUBLIC_URL=https://your-static-domain.ngrok-free.app
BOT_NAME=Meeting Copilot
TRANSCRIPT_LANGUAGE=en

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ACTION_MODEL=claude-sonnet-5-5
FOCUS_MODEL=claude-haiku-5-5
MCP_BETA=mcp-client-2025-11-20

# --- MCP server tokens referenced from mcp_servers.json ---
JIRA_MCP_TOKEN=
SLACK_MCP_TOKEN=
CALENDAR_MCP_TOKEN=

# --- Behaviour ---
AUTO_EXECUTE=false
DRY_RUN=false
DETECT_INTERVAL_S=15
FOCUS_INTERVAL_S=45
WINDOW_S=150
DRIFT_STRIKES=2
WARN_COOLDOWN_S=180
METRICS_DIR=metrics
