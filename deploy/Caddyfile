:8080 {
	# Calendar MCP (gcal_mcp) on its own path
	handle /mcp* {
		reverse_proxy host.docker.internal:9100
	}
	# OpenProject MCP (openproject_mcp): /openproject-mcp/mcp -> /mcp on port 9200
	handle /openproject-mcp* {
		uri strip_prefix /openproject-mcp
		reverse_proxy host.docker.internal:9200
	}
	# Everything else: the copilot app (Recall webhooks, /meetings, ...)
	handle {
		reverse_proxy host.docker.internal:8000
	}
}
